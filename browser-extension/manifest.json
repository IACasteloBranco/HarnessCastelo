{
  "manifest_version": 3,
  "name": "Governança de IA Castelo Branco Contabilidade",
  "version": "0.6.0",
  "key": "",
  "description": "Captura conversas observadas, vinculadas à instalação atribuída.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "http://127.0.0.1:18080/*"],
  "background": {"service_worker": "src/background/service-worker.js", "type": "module"},
  "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}},
  "content_scripts": [
    {"matches": ["https://chatgpt.com/*"], "js": ["src/content/capture-adapter.js", "src/content/blocker-main.js", "src/content/network-probe-main.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://claude.ai/*"], "js": ["src/content/blocker-main.js", "src/content/claude-network-probe-main.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://chatgpt.com/*"], "js": ["src/content/capture-adapter.js", "src/content/platform.js", "src/content/files.js", "src/content/policy-engine.js", "src/content/policy-messages.js", "src/content/observer.js", "src/content/blocker-bridge.js", "src/content/network-bridge.js"], "run_at": "document_start", "world": "ISOLATED"},
    {"matches": ["https://claude.ai/*"], "js": ["src/content/platform.js", "src/content/files.js", "src/content/policy-engine.js", "src/content/policy-messages.js", "src/content/observer.js", "src/content/blocker-bridge.js"], "run_at": "document_start", "world": "ISOLATED"}
  ]
}
